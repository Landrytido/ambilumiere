diff --git a/launcher/app/src/main/java/com/gathin/tvhome/MediaListener.java b/launcher/app/src/main/java/com/gathin/tvhome/MediaListener.java
new file mode 100644
index 00000000..a810c9c9
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/MediaListener.java
@@ -0,0 +1,31 @@
+package com.gathin.tvhome;
+
+import android.os.Handler;
+import android.os.Looper;
+import android.service.notification.NotificationListenerService;
+
+/**
+ * Exists so the launcher can read media sessions (what is playing, see NowPlaying): Android
+ * gives that to apps with notification access. Granted over adb
+ * (cmd notification allow_listener); the launcher never reads or touches notifications.
+ * It also feeds the lights (LightsPalette) from here, so they follow the song whichever screen is up,
+ * not only while Home or the screensaver is showing.
+ * Adapted from majnioui/CleanXiaomiTV (MIT).
+ */
+public class MediaListener extends NotificationListenerService {
+    private NowPlaying music;
+
+    @Override
+    public void onListenerConnected() {
+        if (music == null) {
+            music = new NowPlaying(this, new Handler(Looper.getMainLooper()), track -> LightsPalette.publish(this, track));
+        }
+        music.start();
+    }
+
+    @Override
+    public void onListenerDisconnected() {
+        if (music != null) music.stop();
+        LightsPalette.publish(this, null);
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/NowPlaying.java b/launcher/app/src/main/java/com/gathin/tvhome/NowPlaying.java
new file mode 100644
index 00000000..751307cf
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/NowPlaying.java
@@ -0,0 +1,272 @@
+package com.gathin.tvhome;
+
+import android.app.PendingIntent;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.Bitmap;
+import android.media.MediaMetadata;
+import android.media.session.MediaController;
+import android.media.session.MediaSession;
+import android.media.session.MediaSessionManager;
+import android.media.session.PlaybackState;
+import android.os.Handler;
+import android.os.SystemClock;
+import android.provider.Settings;
+import android.util.Log;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * What is playing in any music app (Spotify, YouTube Music, ...), from Android's media sessions. Read-only:
+ * this launcher shows it and can open the app's player screen, and sends no playback command to the app.
+ * Needs notification access for MediaListener; without it, start() does nothing.
+ * Reports the playing session first, else a paused one, else nothing. A paused one counts only if it was
+ * seen playing (so a video left paused in its app doesn't show up as a song on Home), and only for
+ * PAUSED_FOR_MS after it was first seen paused: apps re-send their paused state now and then, which must
+ * not bring it back.
+ * Adapted from majnioui/CleanXiaomiTV (MIT): same logic, without the play/pause/skip/open commands.
+ */
+final class NowPlaying {
+    private static final String TAG = "TvHome.NowPlaying";
+    /** A song paused longer than this is no longer shown: you've moved on to something else. */
+    private static final long PAUSED_FOR_MS = 30_000L;
+    /** A new song on this TV is followed only after it has played locally this long (see publish()). */
+    private static final long LOCAL_STABLE_MS = 1_500L;
+
+    static final class Track {
+        final String title, artist;
+        final Bitmap art;
+        final boolean playing;
+        final MediaController controller;
+        /** Song length in ms, or 0 when the app doesn't say. */
+        final long duration;
+        /** True when art is the song's cover; false when it is only the app's icon (DISPLAY_ICON). */
+        final boolean artIsCover;
+
+        Track(String title, String artist, Bitmap art, boolean artIsCover, boolean playing, MediaController controller,
+              long duration) {
+            this.title = title;
+            this.artist = artist;
+            this.art = art;
+            this.artIsCover = artIsCover;
+            this.playing = playing;
+            this.controller = controller;
+            this.duration = duration;
+        }
+
+        /** Where playback is now, in ms, extrapolated from the session's last update; -1 when unknown. */
+        long position() {
+            PlaybackState s = controller.getPlaybackState();
+            if (s == null || s.getPosition() < 0) return -1;
+            long pos = s.getPosition();
+            if (s.getState() == PlaybackState.STATE_PLAYING) {
+                pos += (long) ((SystemClock.elapsedRealtime() - s.getLastPositionUpdateTime()) * s.getPlaybackSpeed());
+            }
+            return duration > 0 ? Math.min(pos, duration) : pos;
+        }
+    }
+
+    interface Listener {
+        /** Called on the handler's thread; null when nothing is playing or paused. */
+        void onNowPlaying(Track track);
+    }
+
+    private final Context ctx;
+    private final Handler handler;
+    private final Listener listener;
+    private final ComponentName component;
+    private MediaSessionManager msm;
+    private final List<MediaController> controllers = new ArrayList<>();
+    /** Sessions seen playing, and when each was first seen paused since (elapsedRealtime). Kept across stop(). */
+    private final Set<MediaSession.Token> seenPlaying = new HashSet<>();
+    private final Map<MediaSession.Token, Long> pausedSince = new HashMap<>();
+    /** When each session was first seen playing locally without a break (elapsedRealtime). */
+    private final Map<MediaSession.Token, Long> localSince = new HashMap<>();
+
+    private final MediaController.Callback callback = new MediaController.Callback() {
+        @Override
+        public void onPlaybackStateChanged(PlaybackState state) {
+            publish();
+        }
+
+        @Override
+        public void onMetadataChanged(MediaMetadata metadata) {
+            publish();
+        }
+
+        @Override
+        public void onAudioInfoChanged(MediaController.PlaybackInfo info) {
+            publish();   // local or remote may change while the session lives
+        }
+
+        @Override
+        public void onSessionDestroyed() {
+            publish();
+        }
+    };
+
+    private final MediaSessionManager.OnActiveSessionsChangedListener sessions = this::track;
+    /** Re-checks when a paused song runs out its PAUSED_FOR_MS, since no callback fires then. */
+    private final Runnable recheck = this::publish;
+
+    NowPlaying(Context ctx, Handler handler, Listener listener) {
+        this.ctx = ctx;
+        this.handler = handler;
+        this.listener = listener;
+        this.component = new ComponentName(ctx, MediaListener.class);
+    }
+
+    static boolean hasAccess(Context ctx) {
+        String enabled = Settings.Secure.getString(ctx.getContentResolver(), "enabled_notification_listeners");
+        return enabled != null && enabled.contains(new ComponentName(ctx, MediaListener.class).flattenToString());
+    }
+
+    void start() {
+        if (msm != null || !hasAccess(ctx)) return;
+        try {
+            msm = ctx.getSystemService(MediaSessionManager.class);
+            msm.addOnActiveSessionsChangedListener(sessions, component, handler);
+            track(msm.getActiveSessions(component));
+        } catch (SecurityException e) {
+            Log.w(TAG, "no access: " + e.getMessage());
+            msm = null;
+        }
+    }
+
+    void stop() {
+        handler.removeCallbacks(recheck);
+        if (msm != null) msm.removeOnActiveSessionsChangedListener(sessions);
+        msm = null;
+        for (MediaController c : controllers) c.unregisterCallback(callback);
+        controllers.clear();
+    }
+
+    private void track(List<MediaController> list) {
+        for (MediaController c : controllers) c.unregisterCallback(callback);
+        controllers.clear();
+        Set<MediaSession.Token> live = new HashSet<>();
+        if (list != null) {
+            for (MediaController c : list) {
+                c.registerCallback(callback, handler);
+                controllers.add(c);
+                live.add(c.getSessionToken());
+            }
+        }
+        seenPlaying.retainAll(live);
+        pausedSince.keySet().retainAll(live);
+        localSince.keySet().retainAll(live);
+        publish();
+    }
+
+    private void publish() {
+        handler.removeCallbacks(recheck);
+        MediaController best = null;
+        boolean bestPlaying = false;
+        long pausedLeft = -1;   // ms until the paused candidate expires
+        long settleIn = -1;     // ms until a song that has just started playing locally has settled
+        long now = SystemClock.elapsedRealtime();
+        for (MediaController c : controllers) {
+            PlaybackState s = c.getPlaybackState();
+            if (s == null || c.getMetadata() == null) continue;
+            // A remote session only mirrors what another device plays (a phone on the same Spotify account, say):
+            // the sound does not come from this TV, so neither the card nor the lights follow it.
+            MediaController.PlaybackInfo info = c.getPlaybackInfo();
+            MediaSession.Token token = c.getSessionToken();
+            if (info != null && info.getPlaybackType() == MediaController.PlaybackInfo.PLAYBACK_TYPE_REMOTE) {
+                // Forget it too: when the other device stops, the session turns local again but paused, and it must
+                // not come back as a song this TV played a moment ago.
+                seenPlaying.remove(token);
+                pausedSince.remove(token);
+                localSince.remove(token);
+                continue;
+            }
+            int st = s.getState();
+            boolean playing = st == PlaybackState.STATE_PLAYING || st == PlaybackState.STATE_BUFFERING;
+            if (playing) {
+                // When another device starts a song, the session shows up as local and playing for a fraction of a
+                // second before it says remote. Only a session that stays local for LOCAL_STABLE_MS counts.
+                Long first = localSince.get(token);
+                if (first == null) {
+                    first = now;
+                    localSince.put(token, first);
+                }
+                long wait = LOCAL_STABLE_MS - (now - first);
+                if (wait > 0) {
+                    playing = false;
+                    settleIn = settleIn < 0 ? wait : Math.min(settleIn, wait);
+                }
+            } else {
+                localSince.remove(token);
+            }
+            boolean paused = st == PlaybackState.STATE_PAUSED && seenPlaying.contains(token);
+            if (playing) seenPlaying.add(token);
+            if (st != PlaybackState.STATE_PAUSED) pausedSince.remove(token);
+            if (paused) {
+                Long since = pausedSince.get(token);
+                if (since == null) {
+                    since = Math.min(now, s.getLastPositionUpdateTime());
+                    pausedSince.put(token, since);
+                }
+                long left = PAUSED_FOR_MS - (now - since);
+                if (left <= 0) paused = false;   // paused too long ago: gone
+                else if (best == null) pausedLeft = left;
+            }
+            if (playing && !bestPlaying) {
+                best = c;
+                bestPlaying = true;
+            } else if (paused && best == null) {
+                best = c;
+            }
+        }
+        if (settleIn > 0) handler.postDelayed(recheck, settleIn + 50);
+        if (best == null) {
+            listener.onNowPlaying(null);
+            return;
+        }
+        if (!bestPlaying && pausedLeft > 0) handler.postDelayed(recheck, pausedLeft + 500);
+        MediaMetadata m = best.getMetadata();
+        String title = first(m, MediaMetadata.METADATA_KEY_DISPLAY_TITLE, MediaMetadata.METADATA_KEY_TITLE);
+        if (title.isEmpty()) {
+            listener.onNowPlaying(null);
+            return;
+        }
+        String artist = first(m, MediaMetadata.METADATA_KEY_DISPLAY_SUBTITLE, MediaMetadata.METADATA_KEY_ARTIST,
+                MediaMetadata.METADATA_KEY_ALBUM_ARTIST);
+        Bitmap art = m.getBitmap(MediaMetadata.METADATA_KEY_ALBUM_ART);
+        if (art == null) art = m.getBitmap(MediaMetadata.METADATA_KEY_ART);
+        boolean cover = art != null;
+        if (art == null) art = m.getBitmap(MediaMetadata.METADATA_KEY_DISPLAY_ICON);
+        listener.onNowPlaying(new Track(title, artist, art, cover, bestPlaying, best,
+                Math.max(0, m.getLong(MediaMetadata.METADATA_KEY_DURATION))));
+    }
+
+    /** The music app's own player screen, or failing that its launch screen. */
+    static void open(Context ctx, Track t) {
+        PendingIntent pi = t.controller.getSessionActivity();
+        try {
+            if (pi != null) {
+                pi.send();
+                return;
+            }
+        } catch (PendingIntent.CanceledException ignored) {
+        }
+        String pkg = t.controller.getPackageName();
+        Intent i = ctx.getPackageManager().getLeanbackLaunchIntentForPackage(pkg);
+        if (i == null) i = ctx.getPackageManager().getLaunchIntentForPackage(pkg);
+        if (i != null) ctx.startActivity(i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+    }
+
+    private static String first(MediaMetadata m, String... keys) {
+        for (String k : keys) {
+            CharSequence v = m.getText(k);
+            if (v != null && v.toString().trim().length() > 0) return v.toString().trim();
+        }
+        return "";
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/NowPlayingCard.java b/launcher/app/src/main/java/com/gathin/tvhome/NowPlayingCard.java
new file mode 100644
index 00000000..115d6692
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/NowPlayingCard.java
@@ -0,0 +1,362 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.graphics.Bitmap;
+import android.graphics.BitmapShader;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.LayerDrawable;
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.KeyEvent;
+import android.view.View;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import java.util.Locale;
+
+/**
+ * The now playing card under the top button: the cover, the app's name and state ("SPOTIFY · NOW PLAYING"), the
+ * song and its artist, and a progress line with the time played and the song's length. The glass takes on the
+ * cover's colour, strongest behind the cover and fading to the right. No playback buttons: the remote's own
+ * play/pause keys reach the music app, and OK on the card opens the app's player screen. Up from the card goes
+ * back to the top button and Down on to the dock (see MainActivity). Dimmed while paused. Hidden when nothing is
+ * playing, and faded out while focus is on the rows below the dock, so the rows sliding up never pass under it.
+ * Adapted from majnioui/CleanXiaomiTV (MIT), simplified: no playback buttons, no equalizer, no glass backdrop.
+ */
+final class NowPlayingCard extends LinearLayout {
+    interface Exits {
+        void up();
+
+        void down();
+
+        /** Menu on the card: hide it, and the cover behind Home, until another song plays. */
+        void dismiss();
+    }
+
+    private static final int WIDTH = 156, PAD = 8, ART = 132, RADIUS = 22;
+    private static final long TICK_MS = 1000;
+
+    private final float density;
+    private final GradientDrawable glass;
+    private final ImageView art;
+    /** The cover's colour across the glass; transparent without a cover. */
+    private final GradientDrawable tint;
+    private final TextView kicker, title, artist, elapsed, total;
+    private final LinearLayout body;
+    private final ProgressLine progress;
+    private final LinearLayout times;
+    private NowPlaying.Track track;
+    /** The song the art on screen belongs to, and whether it is the real cover. */
+    private String artKey;
+    private boolean artIsCover;
+    /** True while the card is held back (focus is on the rows below the dock); it comes back with the next dock focus. */
+    private boolean suppressed;
+
+    private final Runnable tick = new Runnable() {
+        @Override
+        public void run() {
+            updateProgress();
+            if (track != null && track.playing && getVisibility() == VISIBLE) postDelayed(this, TICK_MS);
+        }
+    };
+
+    NowPlayingCard(Context ctx, Typeface font, Exits exits) {
+        super(ctx);
+        density = ctx.getResources().getDisplayMetrics().density;
+        setOrientation(VERTICAL);
+        setGravity(Gravity.CENTER_HORIZONTAL);
+        setFocusable(true);
+        setClickable(true);
+        setDescendantFocusability(FOCUS_BLOCK_DESCENDANTS);
+        setVisibility(GONE);
+        setAlpha(0f);
+        setPadding(dp(PAD), dp(PAD), dp(PAD), dp(PAD + 2));
+        setOnClickListener(v -> {
+            if (track != null) NowPlaying.open(getContext(), track);
+        });
+        setOnKeyListener((v, keyCode, event) -> {
+            if (event.getAction() != KeyEvent.ACTION_DOWN) return false;
+            switch (keyCode) {
+                case KeyEvent.KEYCODE_DPAD_UP:
+                    exits.up();
+                    return true;
+                case KeyEvent.KEYCODE_DPAD_DOWN:
+                    exits.down();
+                    return true;
+                case KeyEvent.KEYCODE_MENU:
+                    exits.dismiss();
+                    return true;
+                case KeyEvent.KEYCODE_DPAD_LEFT:
+                case KeyEvent.KEYCODE_DPAD_RIGHT:
+                    return true;    // the card is alone on its line: focus stays put
+                default:
+                    return false;
+            }
+        });
+        setOnFocusChangeListener((v, focused) -> {
+            setRing(focused);
+            animate().scaleX(focused ? 1.02f : 1f).scaleY(focused ? 1.02f : 1f).setDuration(120);
+        });
+
+        glass = new GradientDrawable();
+        glass.setColor(0xA6000000);
+        glass.setCornerRadius(dp(RADIUS));
+        setRing(false);
+        tint = new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM, new int[] {0, 0});
+        tint.setCornerRadius(dp(RADIUS));
+        setBackground(new LayerDrawable(new Drawable[] {glass, tint}));
+
+        art = new ImageView(ctx);
+        art.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        LayoutParams alp = new LayoutParams(dp(ART), dp(ART));
+        alp.bottomMargin = dp(8);
+        addView(art, alp);
+
+        body = new LinearLayout(ctx);
+        body.setOrientation(VERTICAL);
+        kicker = text(ctx, font, 10.5f, 0x99FFFFFF);
+        kicker.setLetterSpacing(0.12f);
+        body.addView(kicker);
+        title = text(ctx, font, 17, 0xFFFFFFFF);
+        LayoutParams tlp = new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT);
+        tlp.topMargin = dp(3);
+        body.addView(title, tlp);
+        artist = text(ctx, font, 13, 0xA6FFFFFF);
+        body.addView(artist);
+
+        progress = new ProgressLine(ctx);
+        LayoutParams plp = new LayoutParams(LayoutParams.MATCH_PARENT, dp(3));
+        plp.topMargin = dp(9);
+        body.addView(progress, plp);
+
+        times = new LinearLayout(ctx);
+        times.setOrientation(HORIZONTAL);
+        elapsed = text(ctx, font, 10.5f, 0x99FFFFFF);
+        total = text(ctx, font, 10.5f, 0x99FFFFFF);
+        total.setGravity(Gravity.END);
+        times.addView(elapsed, new LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f));
+        times.addView(total, new LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f));
+        LayoutParams tmlp = new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT);
+        tmlp.topMargin = dp(3);
+        body.addView(times, tmlp);
+
+        addView(body, new LayoutParams(dp(WIDTH - 2 * PAD), LayoutParams.WRAP_CONTENT));
+    }
+
+    /** Shows the track (dimmed while paused), or fades the card out for null. */
+    void bind(NowPlaying.Track t) {
+        track = t;
+        removeCallbacks(tick);
+        if (t == null) {
+            if (getVisibility() == VISIBLE) {
+                animate().alpha(0f).setDuration(200).withEndAction(() -> {
+                    if (track == null) setVisibility(GONE);
+                });
+            }
+            return;
+        }
+        title.setText(t.title);
+        artist.setText(t.artist);
+        artist.setVisibility(t.artist.isEmpty() ? GONE : VISIBLE);
+        String state = getContext().getString(t.playing ? R.string.np_playing : R.string.np_paused);
+        String app = appName(t.controller.getPackageName());
+        kicker.setText(app.isEmpty() ? state : app + "  ·  " + state);
+        // Apps like Spotify briefly send their own icon instead of the cover when play/pause changes:
+        // keep the cover for the same song, and only take an icon when there is nothing better.
+        String key = t.title + '\u0000' + t.artist;
+        boolean sameSong = key.equals(artKey);
+        if (t.art != null && (!sameSong || (t.artIsCover && !artIsCover))) {
+            art.setImageBitmap(roundedSquare(t.art, dp(ART), dp(16)));
+            art.setVisibility(VISIBLE);
+            setTint(coverColor(t.art));
+            artKey = key;
+            artIsCover = t.artIsCover;
+        } else if (t.art == null && !sameSong) {
+            art.setVisibility(GONE);
+            setTint(0);
+            artKey = key;
+            artIsCover = false;
+        }
+        float dim = t.playing ? 1f : 0.6f;
+        body.setAlpha(dim);
+        art.setAlpha(dim);
+        updateProgress();
+        if (suppressed) return;
+        setVisibility(VISIBLE);
+        animate().cancel();
+        animate().alpha(1f).setDuration(200);
+        if (t.playing) postDelayed(tick, TICK_MS);
+    }
+
+    /** Identifies the song shown (title and artist), or null; the same key MainActivity uses to keep a dismissed song hidden. */
+    static String songKey(NowPlaying.Track t) {
+        return t == null ? null : t.title + '\u0000' + t.artist;
+    }
+
+    String songKey() {
+        return songKey(track);
+    }
+
+    /** The package of the song shown, or null: its app is spared when memory is freed. */
+    String packageName() {
+        return track == null ? null : track.controller.getPackageName();
+    }
+
+    /** True when the card is on screen and can take focus. */
+    boolean canFocus() {
+        return track != null && !suppressed && getVisibility() == VISIBLE && getAlpha() > 0.5f;
+    }
+
+    /**
+     * Holds the card back while focus is on the rows below the dock, and brings it back when it returns to the
+     * dock. The song is still tracked meanwhile, so it shows the right one when it comes back.
+     */
+    void setSuppressed(boolean hold) {
+        if (hold == suppressed) return;
+        suppressed = hold;
+        if (track == null) return;
+        animate().cancel();
+        removeCallbacks(tick);
+        if (hold) {
+            animate().alpha(0f).setDuration(120).withEndAction(() -> {
+                if (suppressed) setVisibility(INVISIBLE);
+            });
+        } else {
+            setVisibility(VISIBLE);
+            animate().alpha(1f).setDuration(150);
+            if (track.playing) post(tick);
+        }
+    }
+
+    /** Stops the clock that moves the progress line; call when Home leaves the screen. */
+    void stop() {
+        removeCallbacks(tick);
+    }
+
+    private void setRing(boolean focused) {
+        glass.setStroke(focused ? dp(2) : Math.max(1, dp(1) / 2), focused ? 0xFFFFFFFF : 0x33FFFFFF);
+    }
+
+    private void updateProgress() {
+        if (track == null || track.duration <= 0) {
+            progress.setFraction(-1f);
+            times.setVisibility(INVISIBLE);
+            return;
+        }
+        long pos = track.position();
+        if (pos < 0) {
+            progress.setFraction(-1f);
+            times.setVisibility(INVISIBLE);
+            return;
+        }
+        progress.setFraction(Math.min(1f, (float) pos / track.duration));
+        elapsed.setText(clock(pos));
+        total.setText(clock(track.duration));
+        times.setVisibility(VISIBLE);
+    }
+
+    private static String clock(long ms) {
+        long s = Math.max(0, ms / 1000);
+        return String.format(Locale.US, "%d:%02d", s / 60, s % 60);
+    }
+
+    /** The music app's name as the TV lists it, or "" when it can't be read. */
+    private String appName(String pkg) {
+        try {
+            PackageManager pm = getContext().getPackageManager();
+            return String.valueOf(pm.getApplicationLabel(pm.getApplicationInfo(pkg, 0))).trim()
+                    .toUpperCase(Locale.getDefault());
+        } catch (PackageManager.NameNotFoundException | RuntimeException e) {
+            return "";
+        }
+    }
+
+    /** The cover's colour, from left to right: strong behind the cover, gone towards the end. */
+    private void setTint(int color) {
+        int c = color & 0x00FFFFFF;
+        tint.setColors(color == 0 ? new int[] {0, 0}
+                : new int[] {0x8C000000 | c, 0x40000000 | c, 0x0D000000 | c});
+    }
+
+    /**
+     * A colour for the glass from the cover: its average, made a little more vivid and kept mid-bright,
+     * so a dark or washed-out cover still gives a visible tint and a bright one doesn't glare.
+     */
+    private static int coverColor(Bitmap art) {
+        Bitmap one = Bitmap.createScaledBitmap(art, 1, 1, true);
+        int avg = one.getPixel(0, 0);
+        if (one != art) one.recycle();
+        float[] hsv = new float[3];
+        Color.colorToHSV(avg, hsv);
+        hsv[1] = Math.min(1f, hsv[1] * 1.4f);
+        hsv[2] = Math.max(0.45f, Math.min(0.75f, hsv[2]));
+        return Color.HSVToColor(hsv);
+    }
+
+    /** The picture cropped to a centred square, scaled to px, with rounded corners. */
+    private static Bitmap roundedSquare(Bitmap src, int px, int radius) {
+        int s = Math.min(src.getWidth(), src.getHeight());
+        Bitmap square = Bitmap.createBitmap(src, (src.getWidth() - s) / 2, (src.getHeight() - s) / 2, s, s);
+        Bitmap scaled = Bitmap.createScaledBitmap(square, px, px, true);
+        Bitmap out = Bitmap.createBitmap(px, px, Bitmap.Config.ARGB_8888);
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+        p.setShader(new BitmapShader(scaled, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP));
+        new Canvas(out).drawRoundRect(new RectF(0, 0, px, px), radius, radius, p);
+        return out;
+    }
+
+    private static TextView text(Context ctx, Typeface font, float sp, int color) {
+        TextView t = new TextView(ctx);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(color);
+        t.setSingleLine(true);
+        t.setEllipsize(TextUtils.TruncateAt.END);
+        t.setIncludeFontPadding(false);
+        if (font != null) t.setTypeface(font);
+        return t;
+    }
+
+    private int dp(int v) {
+        return Math.round(v * density);
+    }
+
+    /** A thin track with the played part in white; hidden while the song's length or position is unknown. */
+    private static final class ProgressLine extends View {
+        private final Paint track = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF rect = new RectF();
+        private float fraction = -1f;
+
+        ProgressLine(Context ctx) {
+            super(ctx);
+            track.setColor(0x40FFFFFF);
+            fill.setColor(0xE6FFFFFF);
+        }
+
+        void setFraction(float f) {
+            if (f == fraction) return;
+            fraction = f;
+            invalidate();
+        }
+
+        @Override
+        protected void onDraw(Canvas c) {
+            if (fraction < 0f) return;
+            float h = getHeight(), r = h / 2f;
+            rect.set(0, 0, getWidth(), h);
+            c.drawRoundRect(rect, r, r, track);
+            rect.set(0, 0, Math.max(h, getWidth() * fraction), h);
+            c.drawRoundRect(rect, r, r, fill);
+        }
+    }
+}
